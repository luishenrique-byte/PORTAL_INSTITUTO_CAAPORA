# Copie para .env e ajuste os valores:  cp .env.example .env
# O .env não vai para o git.

# ---------- Docker Compose (só local) ----------
# Carrega também o docker-compose.local.yml, que abre as portas na sua máquina.
# NÃO configure isto no Easypanel.
COMPOSE_PATH_SEPARATOR=,
COMPOSE_FILE=docker-compose.yml,docker-compose.local.yml

# ---------- Banco (Postgres) ----------
DB_NAME=dbInstituto_Caapora
DB_USER=postgres
DB_PASSWORD=troque-esta-senha
# Porta do Postgres na sua máquina (no container é sempre 5432)
DB_PORT=5433

# ---------- Backend ----------
API_PORT=8080
# update = mantém os dados entre reinícios | create-drop = recria o banco a cada subida
DDL_AUTO=update
# Origens que podem chamar a API, separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Chave do JWT em Base64 (64 bytes). Gere uma com:  openssl rand -base64 64 | tr -d '\n'
# Sem ela, a API usa a chave de desenvolvimento que está no application.yaml (não use fora do local)
# JWT_KEY=
# Validade do token em ms (padrão 15 min)
JWT_EXPIRATION=900000
# Fuso horário da API (as datas são gravadas sem fuso)
TZ_APP=America/Sao_Paulo
UPLOAD_MAX_FILE_SIZE=20MB
# Registro público envia até 5 arquivos de uma vez (5 x 20MB + dados)
UPLOAD_MAX_REQUEST_SIZE=101MB

# ---------- Frontend ----------
WEB_PORT=3000
# URL da API acessada pelo navegador (gravada no build do front; rebuild se mudar)
NEXT_PUBLIC_API_URL=http://localhost:8080
